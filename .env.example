# Environment Configuration Example for Marathi Design Studio
# Copy this file to .env and adjust variables as required.

# Server & Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Security
JWT_SECRET=super-secret-marathi-design-studio-jwt-key-minimum-256-bits-long-key-for-hmac-sha256
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Object Storage / MinIO / S3
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=marathi-design-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI Provider (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
