{
  "name": "marathi-design-studio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise cloud-based Canva-grade Marathi & English design platform",
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
